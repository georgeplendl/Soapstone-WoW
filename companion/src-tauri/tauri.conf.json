{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Soapstone",
  "version": "0.2.3",
  "identifier": "com.georgeplendl.soapstone.companion",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Soapstone",
        "width": 560,
        "height": 600,
        "minWidth": 420,
        "minHeight": 360,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "licenseFile": "../installer-notice.txt",
    "publisher": "George Plendl",
    "homepage": "https://github.com/georgeplendl/Soapstone-WoW",
    "copyright": "Copyright (c) 2026 George Plendl. MIT License.",
    "shortDescription": "Shares Soapstone stones between World of Warcraft players",
    "windows": {
      "nsis": { "installMode": "currentUser", "installerHooks": "windows/hooks.nsh" }
    }
  }
}
